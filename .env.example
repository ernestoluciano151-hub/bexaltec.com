# ─── Bexaltec — Environment Variables ────────────────────────────────────────
# Copy this file to .env.local and fill in the real values.
# Add all these to Vercel → Project → Settings → Environment Variables.

# ── Neon PostgreSQL ──────────────────────────────────────────────────────────
# Get this from: https://console.neon.tech → your project → Connection string
DATABASE_URL="postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/bexaltec?sslmode=require"

# ── JWT Secret ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-key-min-32-chars-here"

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://www.bexaltec.com"
NODE_ENV="production"

# ── Email (pedidos de orçamento para info@bexaltec.com) ──────────────────────
# Sem estas variáveis o pedido fica gravado na base de dados mas NÃO sai email.
# Criar conta em https://resend.com → Domains → adicionar bexaltec.com e publicar
# os registos DNS que o Resend indicar (SPF + DKIM) → API Keys → criar chave.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Remetente. O domínio tem de estar verificado no Resend.
MAIL_FROM="Bexaltec <site@bexaltec.com>"

# Destino interno. Omisso, usa o email de src/lib/contact.ts (info@bexaltec.com).
MAIL_TO="info@bexaltec.com"
