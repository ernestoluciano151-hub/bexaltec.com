# ─── Bexaltec · Caddy (HTTPS e proxy para a aplicação) ──────────────────────
# Em produção o tráfego chega pela Cloudflare (proxy activo, SSL "Full (strict)")
# e o certificado é o Certificado de Origem da Cloudflare, em /certs.
# Para ensaio local: CADDY_TLS=internal e SITE_DOMAIN=localhost.

{
	servers {
		# Só se aceita o IP indicado pela Cloudflare quando o pedido vem de um
		# endereço da Cloudflare (lista oficial: cloudflare.com/ips, 24/11/2026).
		# Rever a lista de vez em quando; muda raramente.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(app) {
	tls {$CADDY_TLS}
	encode zstd gzip
	reverse_proxy web:3000 {
		# A aplicação só confia neste cabeçalho (ver clientIp em src/lib/crm.ts).
		# {client_ip} é o IP real: o da Cloudflare só é aceite se vier de lá.
		header_up X-Real-IP {client_ip}
	}
	log {
		output stdout
		format console
	}
}

{$SITE_DOMAIN} {
	import app
}

# Domínio sem "www" → www (hoje bexaltec.com não abre).
{$APEX_DOMAIN} {
	tls {$CADDY_TLS}
	redir https://{$SITE_DOMAIN}{uri} permanent
}
