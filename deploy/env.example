# ─── Bexaltec · variáveis do servidor ───────────────────────────────────────
# Copiar para .env na raiz do projecto NO SERVIDOR e preencher:
#   cp deploy/env.example .env && chmod 600 .env
# O .env nunca entra no git (está no .gitignore).

# Base de dados (contentor "db"). Gerar com: openssl rand -hex 24
# Só letras e números: a senha entra num URL de ligação.
POSTGRES_DB=bexaltec
POSTGRES_USER=bexaltec
POSTGRES_PASSWORD=

# Sessões. Gerar com: openssl rand -base64 48
# Chave nova na migração: todos os utilizadores voltam a entrar uma vez.
JWT_SECRET=

NEXT_PUBLIC_APP_URL=https://www.bexaltec.com

# Email do formulário de orçamento (Resend). Sem chave, o pedido fica gravado
# na base mas não sai email.
RESEND_API_KEY=
MAIL_FROM=Bexaltec <site@bexaltec.com>
MAIL_TO=info@bexaltec.com

# Domínios servidos pelo Caddy
SITE_DOMAIN=www.bexaltec.com
APEX_DOMAIN=bexaltec.com
# Certificado de Origem da Cloudflare, guardado em ./certs (permissões 600)
CADDY_TLS=/certs/origin.pem /certs/origin-key.pem

# Cópias (hora UTC; 02:00 UTC = 03:00 em Luanda)
BACKUP_TIME_UTC=02:00
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=8
